# Haxball tokens
PUBLIC_TOKEN=
PRIVATE_TOKEN=

# Room passwords (leave empty if no password is needed)
PUBLIC_PASSWORD=
PRIVATE_PASSWORD=

# Language for all text the bot shows (room announcements + Discord).
# Must match a file in src/core/locale/ (e.g. "ru", "en"). Defaults to
# "ru" if left empty. To add a language, see src/core/locale/index.js.
LOCALE=

# Discord bot
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Discord role IDs
DISCORD_VIP_ROLE_ID=
DISCORD_PREADMIN_ROLE_ID=
DISCORD_ADMIN_ROLE_ID=
DISCORD_MASTER_ROLE_ID=

# Discord channel IDs
DISCORD_LOG_CHANNEL_ID=
DISCORD_REPORT_CHANNEL_ID=
DISCORD_REPLAY_CHANNEL_ID=
DISCORD_VIP_CHANNEL_ID=
DISCORD_ANALYTICS_CHANNEL_ID=

# Online messages (the message must be created manually once and its ID must be specified)
DISCORD_PUBLIC_ONLINE_CHANNEL_ID=
DISCORD_PUBLIC_ONLINE_MESSAGE_ID=
DISCORD_PRIVATE_ONLINE_CHANNEL_ID=
DISCORD_PRIVATE_ONLINE_MESSAGE_ID=