# Comma-separated pool of HaxBall headless tokens. The number of rooms
# actually launched is the sum of "count" across every file in
# config/rooms/*.json — you need at least that many tokens here, in any
# order (assignment order = config files sorted by filename, then room
# #1, #2, ... within each file). Startup fails with a clear error if
# there aren't enough tokens for the configured rooms.
HAXBALL_TOKENS=

# Proxies to bypass the HaxBall 2-rooms-per-IP limit. Comma-separated
# list. Supports two formats per entry:
#   - host:port              (no authentication)
#   - user:pass@host:port    (with authentication)
# Both formats can be mixed in the same list.
# The first 2 rooms connect directly; every subsequent pair of rooms
# uses the next proxy from this list. Startup fails if not enough proxies.
# Examples:
#   1.2.3.4:1080,5.6.7.8:1080                            — without auth
#   user:pass@1.2.3.4:1080,user2:pass2@5.6.7.8:1080      — with auth
#   1.2.3.4:1080,user:pass@5.6.7.8:1080                  — mixed
# Leave empty to run all rooms without a proxy.
HAXBALL_PROXIES=

# Where per-room JSON configs live. Defaults to config/rooms/ next to
# this file if left empty — usually no need to set this.
ROOM_CONFIGS_DIR=

# Language for all text the bot shows (room announcements + Discord).
# Must match a file in src/core/locale/ (e.g. "ru", "en"). Defaults to
# "ru" if left empty. To add a language, see src/core/locale/index.js.
LOCALE=

# Time zone (applies to all rooms)
TIME_ZONE=

# Discord bot
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Discord role IDs
DISCORD_VIP_ROLE_ID=
DISCORD_PREADMIN_ROLE_ID=
DISCORD_ADMIN_ROLE_ID=
DISCORD_MASTER_ROLE_ID=

# Discord channel IDs
DISCORD_LOG_CHANNEL_ID=
DISCORD_REPORT_CHANNEL_ID=
DISCORD_REPLAY_CHANNEL_ID=
DISCORD_VIP_CHANNEL_ID=
DISCORD_ANALYTICS_CHANNEL_ID=
DISCORD_ONLINE_CHANNEL_ID=